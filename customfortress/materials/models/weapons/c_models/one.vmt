"VertexLitGeneric"
{
	"$basetexture" "models/weapons/c_models/one"
	//"$phongexponenttexture" "models/weapons/c_models/one_exp"
	"$phong" "1"
	"$phongexponent" "80"
	"$phongboost" "1.5"		
	"$phongfresnelranges"	"[.2 .2 1]"
	"$halflambert" "1"
	"$phongalbedotint" "1"

	"$basemapalphaphongmask" "1"

	// Rim lighting parameters
	"$rimlight" "1"			
	"$rimlightexponent" "65"	
	"$rimlightboost" ".5"
	"$rimmask" "1"

	//"$phongexponentfactor"  "85"

	"$lightwarptexture" "models/lightwarps/softened_weapon_lightwarp"

	//"$envmap" "env_cubemap"
	//"$envmaptint" "[.015 .015 .015]"

	"$glowcolor" "1"

	// Cloaking
	"$cloakPassEnabled" "1"
	"$sheenPassEnabled" "1"



	"$sheenmap" 		"cubemaps\cubemap_sheen001"
	"$sheenmapmask" 		"Effects\AnimatedSheen\animatedsheen0"
	"$sheenmaptint" 		"[ 0.6 0.6 0.6 ]"
	"$sheenmapmaskframe" 	"0"
	"$sheenindex" 		"0"

	"$yellow" "0"

	"Proxies"
	{
		"AnimatedWeaponSheen"
		{
			"animatedtexturevar" 		"$sheenmapmask"
			"animatedtextureframenumvar" 	"$sheenmapmaskframe"
			"animatedtextureframerate" 		"40"
		}
		"invis"
		{
		}
		"ModelGlowColor"
		{
			"resultVar" "$glowcolor"
		}
		"Equals"
		{
			"srcVar1"  "$glowcolor"
			"resultVar" "$selfillumtint"
		}
		"Equals"
		{
			"srcVar1"  "$glowcolor"
			"resultVar" "$color2"
		}
		"YellowLevel"
		{
			"resultVar" "$yellow"
		}
		"Multiply"
		{
			"srcVar1" "$color2"
			"srcVar2" "$yellow"
			"resultVar" "$color2"
		}
	}
}